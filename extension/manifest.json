{
  "manifest_version": 3,
  "name": "Comment Moderator",
  "version": "0.1.2",
  "description": "Analyze YouTube and LinkedIn comments via local backend (read-only).",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.linkedin.com/*", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Comment Moderator"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["linkedin.js"],
      "run_at": "document_idle"
    }
  ]
}