# YouTube Data API v3 (Phase 3 web app only)
YOUTUBE_API_KEY=

# Backend (Phase 2+)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,chrome-extension://

# Logistic regression + optional local Detoxify
USE_TRANSFORMER=true
USE_LLM=true
# Optional separate model chain for creator buckets (comma-separated)
# OPENROUTER_BUCKET_MODELS=meta-llama/llama-3.2-3b-instruct
# Classify viewer comments into creator buckets (moderation-v3) after hybrid scoring
USE_CREATOR_BUCKETS_LLM=true
LR_MODEL_PATH=

# OpenRouter (set models via env — do not hardcode in code)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Optional: if both MODEL and MODELS are empty, API key alone uses DEFAULT_OPENROUTER_MODEL
OPENROUTER_MODELS=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.2-3b-instruct
# Optional: dedicated model for video summaries on Analyze page
OPENROUTER_SUMMARY_MODEL=meta-llama/llama-3.2-3b-instruct:free
LLM_BATCH_SIZE=15
LLM_PROMPT_VERSION=moderation-v1
OPENROUTER_MAX_REQUESTS_PER_DAY=40
OPENROUTER_DAILY_REQUEST_BUFFER=5
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=false
OPENROUTER_REQUESTS_PER_MINUTE=20
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=comment-moderator
OPENROUTER_LOG_KEY_ONCE=true
# Hypothetical cost reporting (eval only, USD per 1M tokens)
OPENROUTER_HYPOTHETICAL_PRICE_PER_M_PROMPT=0
OPENROUTER_HYPOTHETICAL_PRICE_PER_M_COMPLETION=0